# 童心日记本地开发配置
PORT=5178
DATA_DIR=./data

# ========== 微信小程序登录 ==========
WECHAT_APP_ID=wxafcdee5f8f0d4250
WECHAT_APP_SECRET=

# 只用于没有 AppSecret 时的内部测试。正式上线必须保持 false。
ALLOW_DEVICE_AUTH=false
BACKUP_RETENTION_DAYS=30

# ========== 腾讯云语音识别 ASR ==========
# 腾讯云控制台 -> 访问管理 -> API 密钥管理
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 腾讯云账号 APPID，不是小程序 AppID
TENCENT_APP_ID=

# 语音识别地域。常用 ap-shanghai / ap-guangzhou
TENCENT_REGION=ap-shanghai

# 当前一句话识别使用 16k_zh。小朋友普通话先用这个
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh

# ========== 阿里云百炼文本模型 ==========
# 填百炼 API Key。通常在阿里云 DashScope / 模型服务灵积控制台创建
QWEN_API_KEY=

# 主模型负责事实约束成文、修改语义理解和局部重写。
QWEN_MODEL=qwen3.8-max

# 快速模型只负责事实审计和修改计划复核；复杂修改口述仍由主模型理解。
QWEN_FAST_MODEL=deepseek-v4.1-flash

# 结构化事实任务关闭深度思考，减少延迟和输出消耗。
QWEN_ENABLE_THINKING=false

# 百炼兼容 OpenAI 的接口地址，一般不用改
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
