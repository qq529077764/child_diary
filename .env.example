# 童心日记本地开发配置
PORT=5178
DATA_DIR=./data

# ========== 微信小程序登录 ==========
WECHAT_APP_ID=wx79e70247ffdfdde8
WECHAT_APP_SECRET=

# 只用于没有 AppSecret 时的内部测试。正式上线必须保持 false。
ALLOW_DEVICE_AUTH=false

# ========== 腾讯云语音识别 ASR ==========
# 腾讯云控制台 -> 访问管理 -> API 密钥管理
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 腾讯云账号 APPID，不是小程序 AppID
TENCENT_APP_ID=

# 语音识别地域。常用 ap-shanghai / ap-guangzhou
TENCENT_REGION=ap-shanghai

# 实时识别常用 16k_zh。小朋友普通话先用这个
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh

# ========== 通义千问 Qwen 大模型 ==========
# 填通义千问 API Key。通常在阿里云 DashScope / 模型服务灵积控制台创建
QWEN_API_KEY=

# 用来判断缺口、生成追问、事实约束成文的千问模型
# 可先用 qwen-plus；如果你开通了 qwen-turbo / qwen-max 等，也可以改
QWEN_MODEL=qwen-plus

# 千问兼容 OpenAI 的接口地址，一般不用改
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
