# 童心日记本地开发配置
PORT=5178

# ========== 腾讯云语音识别 ASR ==========
# 腾讯云控制台 -> 访问管理 -> API 密钥管理
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 腾讯云账号 APPID，不是小程序 AppID
TENCENT_APP_ID=

# 语音识别地域。常用 ap-shanghai / ap-guangzhou
TENCENT_REGION=ap-shanghai

# 实时识别常用 16k_zh。小朋友普通话先用这个
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh

# ========== 通义千问 Qwen 大模型 ==========
# 填通义千问 API Key。通常在阿里云 DashScope / 模型服务灵积控制台创建
QWEN_API_KEY=

# 用来判断缺口、生成追问、事实约束成文的千问模型
# 可先用 qwen-plus；如果你开通了 qwen-turbo / qwen-max 等，也可以改
QWEN_MODEL=qwen-plus

# 千问兼容 OpenAI 的接口地址，一般不用改
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 兼容旧字段：如果你已经填了 DASHSCOPE_API_KEY，也可以保留
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ========== 可选：通用 ASR HTTP 中转 ==========
# 如果你把腾讯 ASR 封装成自己的云函数/HTTP 服务，可以填这里
# 后端会把音频二进制 POST 到这个地址，并从返回 JSON 的 text/result/transcript 字段取文本
ASR_API_URL=
ASR_API_KEY=

# ========== 可选：OpenAI 音转文 ==========
OPENAI_API_KEY=
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
ASR_LANGUAGE=zh
