<view class="page">
  <view wx:if="{{phase === 'home'}}" class="screen home">
    <view class="hero-card">
      <view class="rabbit large">
        <view class="ear left"></view><view class="ear right"></view>
        <view class="head"><view class="eye left"></view><view class="eye right"></view><view class="nose"></view></view>
      </view>
      <text class="hero-title">今天的小故事，直接说给小耳朵听</text>
      <text class="muted">开始以后一直说就好，中间不需要点按钮。</text>
    </view>
    <view class="theme-card"><text class="eyebrow">今日主题</text><text class="theme">今天你帮助别人做了什么？</text></view>
    <view class="home-actions">
      <button class="button primary" bindtap="startStory">开始说</button>
      <button class="button soft history-entry" bindtap="openHistory">我的日记 {{diaryHistory.length ? diaryHistory.length + ' 篇' : ''}}</button>
      <button class="privacy-entry" bindtap="openPrivacyCenter">家长与隐私</button>
    </view>
  </view>

  <view wx:elif="{{phase === 'history'}}" class="screen history-screen">
    <view class="page-header"><button class="icon-button" bindtap="backHome">‹</button><text class="page-title">我的日记</text><view class="header-spacer"></view></view>
    <scroll-view class="history-list" scroll-y>
      <view wx:if="{{!diaryHistory.length}}" class="history-empty"><text class="empty-title">还没有日记</text><text class="muted center">讲完第一个故事，它就会出现在这里。</text></view>
      <view wx:for="{{diaryHistory}}" wx:key="id" class="history-item" data-id="{{item.id}}" bindtap="openDiaryRecord">
        <view class="history-meta"><text class="history-date">{{item.savedLabel}}</text><text class="history-arrow">›</text></view>
        <text class="history-title">{{item.title}}</text>
        <text class="history-preview">{{item.preview}}</text>
      </view>
    </scroll-view>
    <button class="button primary" bindtap="startStory">讲一个新故事</button>
  </view>

  <view wx:elif="{{phase === 'historyDetail'}}" class="screen history-detail-screen">
    <view class="page-header"><button class="icon-button" bindtap="backHistory">‹</button><text class="page-title">日记详情</text><view class="header-spacer"></view></view>
    <scroll-view class="diary-card stored-diary" scroll-y>
      <text class="saved-time">{{selectedDiary.savedLabel}}</text>
      <text class="diary-title">{{selectedDiary.title}}</text>
      <view class="diary-body"><text wx:for="{{selectedDiary.sentences}}" wx:key="id" class="sentence color-{{index % 3}}">{{item.text}}</text></view>
      <block wx:for="{{selectedDiary.sentences}}" wx:key="id"><view wx:if="{{item.sourceText}}" class="source"><text class="source-sentence">{{item.text}}</text><text class="source-detail">{{item.sourceText}}</text></view></block>
    </scroll-view>
    <view class="detail-actions"><button class="button green" bindtap="restoreDiaryForRevision">恢复并修改</button><button class="button soft" bindtap="backHistory">返回日记本</button><button class="delete-button" bindtap="deleteDiaryRecord">删除日记</button></view>
  </view>

  <view wx:elif="{{phase === 'listen'}}" class="screen listen-screen">
    <view class="page-header flow-header"><button class="icon-button flow-back" disabled="{{isFinishing}}" bindtap="cancelCurrentFlow">‹</button><text class="page-title">讲故事</text><view class="header-spacer"></view></view>
    <view class="topic"><text>今日主题</text><text class="topic-strong">帮助别人</text></view>
    <view class="listen-card {{isRecording ? 'recording' : ''}}">
      <view class="rabbit small">
        <view class="ear left"></view><view class="ear right"></view>
        <view class="head"><view class="eye left"></view><view class="eye right"></view><view class="nose"></view></view>
      </view>
      <text class="listen-title">{{statusTitle}}</text>
      <text class="muted center">{{statusHint}}</text>
      <view wx:if="{{isRecording}}" class="wave"><view></view><view></view><view></view><view></view><view></view></view>
    </view>
    <view class="transcript">
      <text class="transcript-label">刚刚听到</text>
      <scroll-view class="transcript-window" scroll-y scroll-with-animation scroll-into-view="{{transcriptAnchorId}}" show-scrollbar="{{false}}">
        <text class="transcript-text">{{latestText || '开始说以后，最新识别的文字会一直显示在这里'}}</text>
        <view id="{{transcriptAnchorId}}" class="transcript-anchor"></view>
      </scroll-view>
    </view>
    <scroll-view class="feed" scroll-y scroll-with-animation scroll-into-view="{{feedAnchorId}}">
      <view wx:for="{{bubbles}}" wx:key="id" class="bubble {{item.type}}">{{item.text}}</view>
      <view id="{{feedAnchorId}}" class="feed-anchor"></view>
    </scroll-view>
    <scroll-view class="chips" scroll-x><view wx:for="{{factChips}}" wx:key="id" class="chip">{{item.label}}：{{item.text}}</view></scroll-view>
    <view class="actions"><view wx:if="{{isRecording || isFinishing}}" class="button green passive">{{isRecording ? '继续说就好' : '已经停止'}}</view><button wx:else class="button green" bindtap="retryRecording">重新打开麦克风</button><button class="button orange" disabled="{{isFinishing}}" bindtap="finishStory">{{isFinishing ? '正在整理' : '我说完啦'}}</button></view>
  </view>

  <view wx:elif="{{phase === 'diary'}}" class="screen diary-screen">
    <view class="page-header flow-header"><button class="icon-button flow-back" disabled="{{isSaving}}" bindtap="cancelCurrentFlow">‹</button><text class="page-title">预览日记</text><view class="header-spacer"></view></view>
    <scroll-view class="diary-card" scroll-y>
      <text class="eyebrow orange-text">我的日记</text>
      <text class="diary-title">{{diaryTitle}}</text>
      <view class="diary-body"><text wx:for="{{diarySentences}}" wx:key="index" class="sentence color-{{index % 3}}">{{item.text}}</text></view>
      <view class="source" wx:for="{{diarySentences}}" wx:key="index"><text class="source-sentence">{{item.text}}</text><text class="source-detail">{{item.sourceText}}</text></view>
      <view class="pass">事实校验通过：每句话都来自孩子说过的内容。</view>
    </scroll-view>
    <view class="actions"><button class="button green" disabled="{{isSaving}}" bindtap="saveDiary">{{isSaving ? '正在保存' : '就是这样'}}</button><button class="button soft" disabled="{{isSaving}}" bindtap="startRevision">我想改一下</button></view>
  </view>

  <view wx:elif="{{phase === 'revise'}}" class="screen revise-screen">
    <view class="page-header flow-header"><button class="icon-button flow-back" disabled="{{isFinishing}}" bindtap="cancelCurrentFlow">‹</button><text class="page-title">修改日记</text><view class="header-spacer"></view></view>
    <view class="topic"><text>语音修改</text><text class="topic-strong">不用打字</text></view>
    <view class="listen-card revise-card recording">
      <view class="rabbit small"><view class="ear left"></view><view class="ear right"></view><view class="head"><view class="eye left"></view><view class="eye right"></view><view class="nose"></view></view></view>
      <text class="listen-title">正在听你修改</text>
      <scroll-view class="revision-text" scroll-y>{{revisionDisplay || '把想改的那件事重新说一遍，也可以直接说要去掉什么。'}}</scroll-view>
      <view wx:if="{{isRecording}}" class="wave"><view></view><view></view><view></view><view></view><view></view></view>
    </view>
    <view class="tip">只说想改的那件事，其他内容会原样保留。</view>
    <button wx:if="{{isRecording}}" class="button orange bottom" bindtap="applyRevision">说好了，帮我改</button>
    <button wx:elif="{{isFinishing}}" class="button orange bottom" disabled>正在修改</button>
    <button wx:else class="button green bottom" bindtap="retryRecording">重新打开麦克风</button>
  </view>

  <view wx:elif="{{phase === 'privacy'}}" class="screen privacy-screen">
    <view class="page-header"><button class="icon-button" bindtap="backHome">‹</button><text class="page-title">家长与隐私</text><view class="header-spacer"></view></view>
    <scroll-view class="privacy-center" scroll-y>
      <view class="privacy-status {{guardianConsentRecorded ? 'agreed' : ''}}">
        <text class="privacy-status-title">{{guardianConsentRecorded ? '监护人已同意' : '尚未记录监护人同意'}}</text>
        <text class="privacy-status-text">{{guardianConsentRecorded ? '语音整理和云端日记功能可以使用。' : '在开始录音或查看云端日记前，会先请监护人阅读并确认。'}}</text>
      </view>
      <view class="privacy-summary">
        <text class="privacy-heading">我们怎样保护孩子的信息</text>
        <text class="privacy-paragraph">录音只用于语音转文字，本服务不会长期保存录音文件。确认后的日记会保存在服务器，监护人可以删除单篇日记，也可以撤回同意并删除全部数据。</text>
        <text class="privacy-paragraph">我们不会把孩子的信息用于广告、用户画像或公开展示。</text>
      </view>
      <button class="settings-row" bindtap="openChildPrivacyRules"><text>儿童个人信息保护规则</text><text>›</text></button>
      <button class="settings-row" bindtap="openWechatPrivacyContract"><text>小程序隐私保护指引</text><text>›</text></button>
      <view class="contact-row"><text>联系邮箱</text><text>529077764@qq.com</text></view>
    </scroll-view>
    <button wx:if="{{guardianConsentRecorded}}" class="danger-outline" bindtap="withdrawGuardianConsent">撤回同意并删除全部数据</button>
  </view>

  <view wx:else class="screen success">
    <view class="success-icon">✓</view><text class="hero-title">保存成功</text><text class="muted">今天的小故事已经放进日记本里啦。</text>
    <view class="actions bottom"><button class="button green" bindtap="openHistory">查看日记本</button><button class="button primary" bindtap="restart">再讲一篇</button></view>
  </view>

  <view wx:if="{{showGuardianConsent}}" class="privacy-mask">
    <view class="guardian-dialog">
      <text class="guardian-kicker">请家长阅读</text>
      <text class="guardian-title">监护人同意后再开始</text>
      <text class="guardian-copy">童心日记面向儿童使用。我们会处理孩子的录音片段、转写文字和日记内容，用于语音识别、问题引导、日记整理与保存。</text>
      <text class="guardian-copy">录音不会在日记服务器长期保存；日记可随时删除，也可撤回同意并删除全部数据。</text>
      <view class="guardian-links">
        <button class="text-link" bindtap="openChildPrivacyRules">儿童个人信息保护规则</button>
        <button class="text-link" bindtap="openWechatPrivacyContract">小程序隐私保护指引</button>
      </view>
      <button id="guardian-agree-button" class="button green consent-agree" open-type="agreePrivacyAuthorization" bindtap="confirmGuardianConsent" bindagreeprivacyauthorization="confirmGuardianConsent">我是监护人并同意</button>
      <button id="guardian-decline-button" class="consent-decline" bindtap="declineGuardianConsent">暂不使用</button>
    </view>
  </view>

  <view wx:if="{{showChildPrivacyRules}}" class="privacy-mask rules-mask">
    <view class="rules-dialog">
      <view class="rules-header"><text class="rules-title">儿童个人信息保护规则</text><button class="rules-close" bindtap="closeChildPrivacyRules">×</button></view>
      <scroll-view class="rules-scroll" scroll-y>
        <text class="rules-intro">更新及生效日期：2026年10月9日</text>
        <text class="rules-intro">请监护人在孩子使用前完整阅读。只有在监护人同意后，童心日记才会连接服务器或打开麦克风。</text>
        <view wx:for="{{childPrivacySections}}" wx:key="title" class="rules-section">
          <text class="rules-section-title">{{index + 1}}. {{item.title}}</text>
          <text class="rules-section-text">{{item.text}}</text>
        </view>
      </scroll-view>
      <button class="button primary rules-done" bindtap="closeChildPrivacyRules">我已阅读</button>
    </view>
  </view>
</view>
